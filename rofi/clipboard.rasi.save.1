Nerd Font 12"; /* Change to your preferred font */
}

window {
    width: 550px;
    background-color: @bg-color;
    border: 2px solid;
    border-color: @accent;
    border-radius: 12px;
    padding: 15px;
}

inputbar {
    background-color: @bg-alt;
    border-radius: 8px;
    padding: 10px;
    children: [prompt, entry];
}

prompt {
    text-color: @accent;
    padding: 0 10px 0 0;
    font: "JetBrainsMono Nerd Font Bold 12";
}

entry {
    placeholder: "Search...";
    placeholder-color: #6c7086;
}

listview {
    margin: 15px 0 0 0;
    lines: 8;
    scrollbar: false;
}

element {
    padding: 10px;
    border-radius: 8px;
}

element selected {
    background-color: @bg-alt;
    text-color: @accent;
}
element {
    padding: 10px;
    border-radius: 8px;
    spacing: 10px; /* Space between icon and text */
    children: [element-icon, element-text];
}

element-icon {
    size: 3em; /* Size of the image preview */
    background-color: transparent;
}

element-text {
    vertical-align: 0.5; /* Centers text next to the image */
    background-color: transparent;
    text-color: inherit;
}
